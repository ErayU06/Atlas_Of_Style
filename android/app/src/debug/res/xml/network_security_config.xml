<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only: permits plain HTTP to the local dev server (via `adb reverse`
  or the Android emulator's host alias). This source set is never merged
  into release builds — production keeps the default HTTPS-only policy.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
