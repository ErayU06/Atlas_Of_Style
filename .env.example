# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # PostgreSQL connection string (postgresql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID
VITE_API_BASE_URL=       # Optional. Overrides the backend address compiled into the app (see PRODUCTION_API_BASE_URL in src/config.ts) — set it to point a build at staging or a local server. Must be a plain https:// URL or it is ignored in favour of the built-in one. Web ignores this entirely and calls /api/trpc on its own origin.

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Backend (CORS) ────────────────────────────────────────────
CAPACITOR_ORIGINS=        # Comma-separated extra origins allowed to call the API with credentials (e.g. a custom androidScheme host). Capacitor's default https://localhost is always allowed.

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login
